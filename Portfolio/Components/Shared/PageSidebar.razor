@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject Portfolio.Services.IPortfolioContentService Content

<aside
    id="portfolio-sidebar"
    class="page-sidebar"
    aria-label="Redes sociais">

    <div class="page-sidebar-socials">

        <a
            href="@GithubUrl"
            class="page-sidebar-social"
            aria-label="GitHub"
            target="_blank"
            rel="noopener noreferrer">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                    d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.92.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18A10.93 10.93 0 0 1 12 6.34c.97 0 1.94.13 2.85.38 2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.77.11 3.06.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.68.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
            </svg>

        </a>

        <a
            href="@LinkedInUrl"
            class="page-sidebar-social"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener noreferrer">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                    d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM2.75 9.75h4.5V21h-4.5V9.75ZM10 9.75h4.31v1.54h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V21h-4.5v-4.57c0-1.09-.02-2.5-1.52-2.5-1.52 0-1.75 1.19-1.75 2.42V21H10V9.75Z"/>
            </svg>

        </a>

    </div>

    <span
        class="page-sidebar-line"
        aria-hidden="true">
    </span>

</aside>

@code {

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync(
            "portfolioSidebar.initialize");
    }

    private string GithubUrl = "#", LinkedInUrl = "#";

    protected override async Task OnInitializedAsync()
    {
        var s = await Content.GetSettingsAsync();
        if (s is null) return;
        if (!string.IsNullOrWhiteSpace(s.GithubUrl)) GithubUrl = s.GithubUrl;
        if (!string.IsNullOrWhiteSpace(s.LinkedInUrl)) LinkedInUrl = s.LinkedInUrl;
    }
    

}