@page "/admin/about"
@layout AdminLayout
@using Portfolio.Components.Admin.FormModels
@inject IPortfolioContentService Content
@inject ILogger<AdminAbout> Logger
<AdminPageHeader Title="Sobre" Description="Edite o título, texto e imagem da seção Sobre do portfólio." />
@if(!string.IsNullOrWhiteSpace(message)){<AdminAlert Message="@message" Kind="@messageKind" OnDismiss="DismissMessage"/>}
<section class="admin-panel editor-panel"><div class="panel-heading"><div><h2>Conteúdo da seção</h2><p>O texto pode ser atualizado aqui sem alterar o restante do layout público.</p></div></div>
@if(loading){<div class="loading-state">Carregando conteúdo…</div>}
else{<EditForm Model="form" FormName="about-form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary class="validation-summary"/><div class="form-grid"><div class="field field-wide"><label>Título <span>*</span></label><InputText @bind-Value="form.Title"/><ValidationMessage For="@(()=>form.Title)"/></div><div class="field field-wide"><label>Descrição</label><InputTextArea @bind-Value="form.Description" rows="6" placeholder="Escreva um texto de apresentação"/></div><div class="field field-wide"><label>Imagem</label><AdminImageUpload Kind="profile" @bind-Value="form.Image"/></div></div><div class="form-actions"><button class="admin-primary-button" type="submit">Salvar seção</button></div></EditForm>}
</section>
@code{
private AboutForm form=new();private Portfolio.Models.About? target;private bool loading=true;private string message="",messageKind="success";
protected override async Task OnInitializedAsync(){try{await Reload();}catch(Exception ex){Logger.LogError(ex,"Failed to load Admin About content");SetMessage("Não foi possível carregar a seção Sobre. Tente novamente.","error");}finally{loading=false;}}
private async Task Reload(){target=await Content.GetAboutAsync();if(target is not null)form=new(){Id=target.Id,Title=target.Title,Description=target.Description,Image=target.Image};}
private async Task Save(){try{var value=new Portfolio.Models.About{Id=form.Id,Title=form.Title.Trim(),Description=form.Description.Trim(),Image=form.Image};await Content.SaveAboutAsync(value);await Reload();SetMessage("Seção Sobre salva com sucesso.");}catch(Exception ex){Logger.LogError(ex,"Failed to save Admin About content");SetMessage("Não foi possível salvar a seção Sobre. Tente novamente.","error");}}
private void SetMessage(string text,string kind="success"){message=text;messageKind=kind;}private Task DismissMessage(){message="";return Task.CompletedTask;}
}
