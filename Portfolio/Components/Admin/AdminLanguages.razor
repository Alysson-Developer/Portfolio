@page "/admin/languages"
@layout AdminLayout
@using Portfolio.Components.Admin.FormModels
@using Portfolio.Services
@inject IPortfolioContentService Content
@inject ILogger<AdminLanguages> Logger
@inject IJSRuntime JS
<AdminPageHeader Title="Idiomas" Description="Gerencie os idiomas exibidos na seção Sobre."><button class="admin-primary-button" type="button" @onclick="NewItem">＋ Adicionar idioma</button></AdminPageHeader>
@if(!string.IsNullOrWhiteSpace(message)){<AdminAlert Message="@message" Kind="@messageKind" OnDismiss="DismissMessage"/>}
@if(showForm){<section class="admin-panel editor-panel"><div class="panel-heading"><div><h2>@(form.Id==0?"Novo idioma":"Editar idioma")</h2><p>Registre a proficiência informada por você; nenhum nível será preenchido automaticamente.</p></div><button class="icon-button" type="button" @onclick="CancelForm" aria-label="Fechar">×</button></div>
<EditForm Model="form" FormName="language-form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary class="validation-summary"/><div class="form-grid"><div class="field"><label>Nome do idioma <span>*</span></label><InputText @bind-Value="form.Name" placeholder="Ex.: Português"/><ValidationMessage For="@(()=>form.Name)"/></div><div class="field"><label for="language-proficiency">Proficiência</label><div class="proficiency-control"><input id="language-proficiency" type="range" min="0" max="100" step="1" @bind="form.Proficiency" @bind:event="oninput"/><output for="language-proficiency">@form.Proficiency%</output></div><ValidationMessage For="@(()=>form.Proficiency)"/></div><div class="field"><label>Ordem</label><InputNumber @bind-Value="form.Order"/></div></div><div class="form-actions"><button class="admin-primary-button" type="submit">@(form.Id==0?"Adicionar idioma":"Salvar alterações")</button><button class="secondary-button" type="button" @onclick="CancelForm">Cancelar</button></div></EditForm></section>}
<section class="admin-panel list-panel"><div class="panel-heading"><div><h2>Idiomas cadastrados</h2><p>@items.Count @(items.Count==1?"idioma":"idiomas")</p></div></div>
@if(items.Count==0){<div class="empty-state"><span>文</span><h3>Nenhum idioma cadastrado</h3><p>Adicione um idioma para exibi-lo na seção Sobre.</p><button class="secondary-button" @onclick="NewItem">Adicionar primeiro idioma</button></div>}
else{<div class="table-scroll"><table class="admin-table"><thead><tr><th>Idioma</th><th>Proficiência</th><th>Ordem</th><th class="actions-column">Ações</th></tr></thead><tbody>@foreach(var item in items){<tr><td><strong>@item.Name</strong></td><td>@item.Proficiency%</td><td>@item.Order</td><td><div class="row-actions"><button class="text-action" @onclick="()=>Edit(item)">Editar</button><button class="text-action danger-action" @onclick="()=>Delete(item)">Excluir</button></div></td></tr>}</tbody></table></div>}
</section>
@code{
private List<Language> items=[];private LanguageForm form=new();private Language? editTarget;private bool showForm;private string message="",messageKind="success";
protected override async Task OnInitializedAsync(){await Load();}private async Task<bool> Load(){try{items=await Content.GetLanguagesAsync();return true;}catch(Exception ex){Logger.LogError(ex,"Admin Language operation failed at /admin/languages");SetMessage("Não foi possível carregar os idiomas. Tente novamente.","error");return false;}}
private void NewItem(){form=new();editTarget=null;showForm=true;ClearMessage();}private void Edit(Language item){editTarget=item;form=new(){Id=item.Id,Name=item.Name,Proficiency=item.Proficiency,Order=item.Order};showForm=true;ClearMessage();}
private async Task Save(){try{if(form.Proficiency is < 0 or > 100)throw new InvalidOperationException("Language proficiency must be between 0 and 100.");var value=editTarget??new Language();value.Name=form.Name.Trim();value.Proficiency=form.Proficiency;value.Order=form.Order;await Content.SaveLanguageAsync(value);showForm=false;if(!await Load())return;SetMessage(form.Id==0?"Idioma adicionado com sucesso.":"Idioma atualizado com sucesso.");}catch(Exception ex){Logger.LogError(ex,"Admin Language operation failed at /admin/languages");SetMessage("Não foi possível salvar o idioma. Tente novamente.","error");}}
private async Task Delete(Language item){if(!await JS.InvokeAsync<bool>("confirm",$"Excluir o idioma ‘{item.Name}’? Esta ação não pode ser desfeita."))return;try{await Content.DeleteLanguageAsync(item.Id);if(!await Load())return;SetMessage("Idioma excluído com sucesso.");}catch(Exception ex){Logger.LogError(ex,"Admin Language operation failed at /admin/languages");SetMessage("Não foi possível excluir o idioma. Tente novamente.","error");}}
private void CancelForm(){showForm=false;editTarget=null;}private void SetMessage(string text,string kind="success"){message=text;messageKind=kind;}private void ClearMessage(){message="";messageKind="success";}private Task DismissMessage(){message="";return Task.CompletedTask;}
}
