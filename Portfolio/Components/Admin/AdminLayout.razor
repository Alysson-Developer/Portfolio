@inherits LayoutComponentBase
<div class="admin-shell">
    <aside class="admin-sidebar @(sidebarOpen ? "is-open" : "")">
        <a class="admin-brand" href="/admin" aria-label="Administração Portfolio">
            <span class="admin-brand-mark">P</span>
            <span><strong>Portfolio</strong><small>PAINEL ADMINISTRATIVO</small></span>
        </a>
        <nav class="admin-nav" aria-label="Menu administrativo" @onclick="CloseSidebar">
            <span class="admin-nav-label">GERENCIAMENTO</span>
            <NavLink href="/admin" Match="NavLinkMatch.All"><span class="nav-icon">⌂</span>Dashboard</NavLink>
            <NavLink href="/admin/projects"><span class="nav-icon">▧</span>Projetos</NavLink>
            <NavLink href="/admin/experience"><span class="nav-icon">◷</span>Experiência</NavLink>
            <NavLink href="/admin/education"><span class="nav-icon">▤</span>Educação</NavLink>
            <NavLink href="/admin/technologies"><span class="nav-icon">◇</span>Tecnologias</NavLink>
            <NavLink href="/admin/about"><span class="nav-icon">◎</span>Sobre</NavLink>
            <NavLink href="/admin/languages"><span class="nav-icon">文</span>Idiomas</NavLink>
            <NavLink href="/admin/settings"><span class="nav-icon">⚙</span>Configurações</NavLink>
        </nav>
        <div class="admin-sidebar-footer">
            <a href="/"><span class="nav-icon">↗</span>Voltar para o site</a>
            <form action="/admin/logout" method="post"><button type="submit"><span class="nav-icon">⇥</span>Sair</button></form>
        </div>
    </aside>
    @if (sidebarOpen) { <button class="admin-scrim" @onclick="ToggleSidebar" aria-label="Fechar menu"></button> }
    <div class="admin-main">
        <header class="admin-topbar">
            <button class="admin-menu-toggle" @onclick="ToggleSidebar" aria-label="Abrir menu">☰</button>
            <span>Administração <span class="topbar-divider">/</span> <strong>@CurrentSection</strong></span>
            <a href="/" class="topbar-site-link">Ver site <span>↗</span></a>
        </header>
        <main class="admin-content">@Body</main>
    </div>
</div>
@code {
    private bool sidebarOpen;
    private string CurrentSection => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0] switch {
        "admin" => "Dashboard", "admin/projects" => "Projetos", "admin/experience" => "Experiência",
        "admin/education" => "Educação", "admin/technologies" => "Tecnologias", "admin/about" => "Sobre",
        "admin/languages" => "Idiomas", "admin/settings" => "Configurações", _ => "Administração" };
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    private void CloseSidebar() => sidebarOpen = false;
}
