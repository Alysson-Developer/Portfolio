@page "/admin/projects"
@layout AdminLayout
@using Portfolio.Components.Admin.FormModels
@inject IPortfolioContentService Content
@inject ILogger<AdminProjects> Logger
@inject IJSRuntime JS
<AdminPageHeader Title="Projetos" Description="Gerencie os trabalhos exibidos no seu portfólio.">
    <button class="admin-primary-button" type="button" @onclick="NewProject"><span>＋</span> Novo projeto</button>
</AdminPageHeader>
@if (!string.IsNullOrWhiteSpace(message)) { <AdminAlert Message="@message" Kind="@messageKind" OnDismiss="DismissMessage" /> }
@if (showForm)
{
    <section class="admin-panel editor-panel">
        <div class="panel-heading"><div><h2>@(form.Id == 0 ? "Novo projeto" : "Editar projeto")</h2><p>Preencha as informações que serão exibidas no portfólio.</p></div><button class="icon-button" type="button" @onclick="CancelForm" aria-label="Fechar">×</button></div>
        <EditForm Model="form" FormName="project-form" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />
            <div class="form-grid">
                <div class="field"><label for="project-name">Nome do projeto <span>*</span></label><InputText id="project-name" @bind-Value="form.Name" placeholder="Ex.: Aplicação de controle financeiro"/><ValidationMessage For="@(()=>form.Name)" /></div>
                <div class="field"><label for="project-org">Organização</label><InputText id="project-org" @bind-Value="form.Organization" placeholder="Empresa, equipe ou projeto pessoal"/><ValidationMessage For="@(()=>form.Organization)" /></div>
                <div class="field field-wide"><label for="project-description">Descrição</label><InputTextArea id="project-description" @bind-Value="form.Description" rows="4" placeholder="Descreva brevemente o projeto"/><ValidationMessage For="@(()=>form.Description)" /></div>
                <div class="field"><label for="project-url">URL do projeto</label><InputText id="project-url" @bind-Value="form.Url" placeholder="https://"/><ValidationMessage For="@(()=>form.Url)" /></div>
                <div class="field"><label for="project-order">Ordem</label><InputNumber id="project-order" @bind-Value="form.Order"/><ValidationMessage For="@(()=>form.Order)" /></div>
                <div class="field field-wide"><label>Imagem do projeto</label><AdminImageUpload Kind="projects" @bind-Value="form.Image" /></div>
                <div class="field field-wide"><label>Tecnologias cadastradas</label><AdminTechnologyPicker Items="technologies" @bind-SelectedIds="form.TechnologyIds" /></div>
            </div>
            <div class="form-actions"><button class="admin-primary-button" type="submit">@(form.Id == 0 ? "Criar projeto" : "Salvar alterações")</button><button class="secondary-button" type="button" @onclick="CancelForm">Cancelar</button></div>
        </EditForm>
    </section>
}
<section class="admin-panel list-panel">
    <div class="panel-heading"><div><h2>Todos os projetos</h2><p>@items.Count @(items.Count == 1 ? "projeto cadastrado" : "projetos cadastrados")</p></div></div>
    @if (items.Count == 0) { <div class="empty-state"><span>▧</span><h3>Nenhum projeto cadastrado</h3><p>Adicione um projeto para começar a montar esta seção do portfólio.</p><button class="secondary-button" type="button" @onclick="NewProject">Adicionar primeiro projeto</button></div> }
    else { <div class="table-scroll"><table class="admin-table"><thead><tr><th>Projeto</th><th>Tecnologias</th><th>Ordem</th><th class="actions-column">Ações</th></tr></thead><tbody>
        @foreach(var item in items){<tr><td><div class="record-with-image"><div class="record-thumbnail">@if(!string.IsNullOrWhiteSpace(item.Image)){<img src="@item.Image" alt=""/>}else{<span>▧</span>}</div><div><strong>@item.Name</strong><small>@(string.IsNullOrWhiteSpace(item.Organization) ? "Sem organização" : item.Organization)</small></div></div></td><td><div class="table-chips">@foreach(var tech in item.ProjectTechnologies.Take(3)){<span>@tech.Technology.Name</span>}@if(item.ProjectTechnologies.Count>3){<small>+@(item.ProjectTechnologies.Count-3)</small>}</div></td><td>@item.Order</td><td><div class="row-actions"><button type="button" class="text-action" @onclick="()=>Edit(item)">Editar</button><button type="button" class="text-action danger-action" @onclick="()=>Delete(item)">Excluir</button></div></td></tr>}
    </tbody></table></div> }
</section>
@code {
    private List<Project> items=[]; private List<Technology> technologies=[]; private ProjectForm form=new(); private Project? editTarget; private bool showForm; private string message="", messageKind="success";
    protected override async Task OnInitializedAsync(){await Load();try{technologies=await Content.GetTechnologiesAsync();}catch(Exception ex){Logger.LogError(ex,"Failed to load technologies for project selection");SetMessage("Não foi possível carregar as tecnologias cadastradas.","error");}}
    private async Task<bool> Load(){try{items=await Content.GetProjectsAsync();return true;}catch(Exception ex){Logger.LogError(ex,"Admin Project operation failed at /admin/projects");SetMessage("Não foi possível carregar os projetos. Tente novamente.","error");return false;}}
    private void NewProject(){editTarget=null;form=new();showForm=true;ClearMessage();}
    private void Edit(Project item){editTarget=item;form=new(){Id=item.Id,Name=item.Name,Organization=item.Organization,Description=item.Description,Url=item.Url,Image=item.Image,Order=item.Order,TechnologyIds=item.ProjectTechnologies.Select(t=>t.TechnologyId).ToList()};showForm=true;ClearMessage();}
    private async Task Save(){try{var target=editTarget??new Project();target.Name=form.Name.Trim();target.Organization=form.Organization.Trim();target.Description=form.Description.Trim();target.Url=form.Url?.Trim();target.Image=form.Image;target.Order=form.Order;target.ProjectTechnologies.Clear();foreach(var id in form.TechnologyIds)target.ProjectTechnologies.Add(new ProjectTechnology{TechnologyId=id});await Content.SaveProjectAsync(target);showForm=false;if(!await Load())return;SetMessage(form.Id==0?"Projeto criado com sucesso.":"Projeto atualizado com sucesso.");}catch(Exception ex){Logger.LogError(ex,"Admin Project operation failed at /admin/projects");SetMessage("Não foi possível salvar o projeto. Tente novamente.","error");}}
    private async Task Delete(Project item){if(!await JS.InvokeAsync<bool>("confirm",$"Excluir o projeto ‘{item.Name}’? Esta ação não pode ser desfeita."))return;try{await Content.DeleteProjectAsync(item.Id);if(!await Load())return;SetMessage("Projeto excluído com sucesso.");}catch(Exception ex){Logger.LogError(ex,"Admin Project operation failed at /admin/projects");SetMessage("Não foi possível excluir o projeto. Tente novamente.","error");}}
    private void CancelForm(){showForm=false;editTarget=null;}
    private void SetMessage(string text,string kind="success"){message=text;messageKind=kind;} private void ClearMessage(){message="";messageKind="success";} private Task DismissMessage(){message="";return Task.CompletedTask;}
}
