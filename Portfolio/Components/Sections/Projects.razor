@using Portfolio.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject Portfolio.Services.IPortfolioContentService Content
@implements IAsyncDisposable

<section id="projetos" class="projects-section portfolio-section">

    <div class="projects-container portfolio-container">

        <header class="projects-header">

            <h2 class="projects-title">
                Projetos
            </h2>

            <p class="projects-description">
                Aqui você encontra todos os projetos em que já trabalhei,
                sejam pessoais ou aqueles realizados com vínculo empregatício,
                nos quais atuei no time de desenvolvimento.
            </p>

        </header>

        <div class="projects-carousel">

            <button
                class="projects-navigation projects-previous @(CanGoPrevious ? "is-visible" : "")"
                type="button"
                @onclick="PreviousProject"
                aria-label="Projetos anteriores">

                &lt;

            </button>

            <div
                @ref="_track"
                class="projects-track">

                @foreach (var project in ProjectItems)
                {
                    <ProjectCard Project="project" />
                }

            </div>

            <button
                class="projects-navigation projects-next @(CanGoNext ? "is-visible" : "")"
                type="button"
                @onclick="NextProject"
                aria-label="Próximos projetos">

                &gt;

            </button>

        </div>

        <div class="projects-progress">

            <span
                style="
            width: @(ProgressWidth)%;
            transform: translateX(@(ProgressPosition)%);
        ">
            </span>

        </div>

    </div>

</section>

@code {

    private ElementReference _track;

    private IJSObjectReference? _module;

    private DotNetObjectReference<Projects>? _dotNetReference;

    private double ProgressPosition { get; set; }

    private double ProgressWidth { get; set; }

    private bool CanGoPrevious { get; set; }

    private bool CanGoNext { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/projectsCarousel.js");

        _dotNetReference =
            DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(
            "initialize",
            _track,
            _dotNetReference);
    }

    private async Task NextProject()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync(
            "scrollNext",
            _track);
    }
    private async Task PreviousProject()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync(
            "scrollPrevious",
            _track);
    }

    [JSInvokable]
    public Task UpdateProgress(
        double position,
        double width,
        bool canGoPrevious,
        bool canGoNext)
    {
        ProgressPosition = position;
        ProgressWidth = width;

        CanGoPrevious = canGoPrevious;
        CanGoNext = canGoNext;

        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetReference?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private List<Project> ProjectItems = [];
    protected override async Task OnInitializedAsync() => ProjectItems = await Content.GetProjectsAsync();

}